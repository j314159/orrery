    android:viewportHeight="108">

    <!-- Orbit ring — centered on the sun at (54,54), radius 20 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.4"
        android:fillColor="#00000000"
        android:pathData="M54,54m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0" />

    <!-- Central sun — golden with bright core -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M54,54m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
    <path
        android:fillColor="#FFF0A0"
        android:pathData="M54,54m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />

    <!-- Earth — INSIDE the orbit ring at 10 o'clock position
         Actual heliocentric ecliptic longitude on Aug 16, 1980 23:57: 324.2°
         (Josh's birthday Easter egg) -->
