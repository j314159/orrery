        android:fillColor="#4488CC"
        android:pathData="M44,48m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0" />

    <!-- Mars — ON the orbit ring at 1 o'clock position
         Actual heliocentric ecliptic longitude on Aug 16, 1980 23:57: 236.4°
         88° behind Earth in orbital motion -->
    <path
        android:fillColor="#FF6633"
        android:pathData="M63,36m-3.2,0a3.2,3.2 0,1 1,6.4 0a3.2,3.2 0,1 1,-6.4 0" />

